HOST=0.0.0.0
PORT=3002
LOG_LEVEL=info
NODE_ENV=development

# Vocabulary endpoint (internal only)
# Set to a strong random secret to enable POST /vocabulary/accept.
# Leave unset to keep the endpoint dark (returns 404). Never expose this publicly.
VOCAB_SECRET=
# Directory to persist per-client vocabulary JSON files (one file per clientId).
# If unset, an in-memory store is used (vocabulary lost on restart).
VOCAB_DIR=

# Anthropic (full AI mapping; heuristic fallback when unset)
ANTHROPIC_API_KEY=
# Use ANTHROPIC_MODEL or ANTHROPIC_TEXT_MODEL
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096
AI_MAPPING_ENABLED=true
AI_FALLBACK_ENABLED=true
AI_FALLBACK_THRESHOLD=0.75
# Candidates below this score go to lowConfidenceMappings (review) instead of auto-apply
MAPPING_AUTO_APPLY_THRESHOLD=0.45
