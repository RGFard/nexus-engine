      "reasoning": "The HS code is the export (outbound) code."
    },
    {
      "sourceField": "/customs/lineItems[]/countryOfOrigin",
      "targetField": "/content/exportDeclarations[0]/lineItems[]/manufacturerCountry",
      "confidence": 1,
      "transformation": "array:map|normalize:countryCode|cast:string",
      "reasoning": "Country where the goods were made."
    },
    {
      "sourceField": "/customs/lineItems[]/weight/value",
      "targetField": "/content/exportDeclarations[0]/lineItems[]/weight/netValue",
      "confidence": 1,
