  "unmappedSourceFields": [],
  "unmappedTargetFields": [
    "/customerReferences",
    "/localProductCode"
  ],
  "dropIfMissing": {
    "/content/exportDeclarations": "/content/exportDeclarations[0]/lineItems"
  },
  "defaults": {
    "/pickup/isRequested": false,
    "/accounts[0]/typeCode": "shipper",
    "/content/isCustomsDeclarable": false,
    "/content/description": "General goods",
    "/outputImageProperties/encodingFormat": "pdf"
  },
  "parameters": {
    "serviceCode": {
      "targetField": "/productCode",
      "header": "X-Service-Code",
      "description": "DHL product code to ship with, e.g. P for Express Worldwide or N for domestic. Send it when the shipment did not come from DHL. When given, it replaces /carrier/serviceCode."
    },
    "accountNumber": {
      "targetField": "/accounts[0]/number",
      "header": "X-Account-Number",
      "description": "DHL account to bill. Send it when the source carries no DHL account number. When given, it replaces /carrier/accountNumber."
    }
  },
  "units": {
    "weight": {
      "accepted": [
        "kg",
        "lb"
      ],
      "convert": {
        "oz": "lb",
        "g": "kg"
      }
    },
    "dimension": {
      "accepted": [
        "cm",
        "in"
      ],
      "convert": {
        "m": "cm"
      }
    }
  },
  "knownGaps": [
    "unitOfMeasurement comes from the first package. Packages or customs lines in a different unit system (kg next to lb) are sent as is and DHL reads them wrongly.",
    "plannedShippingDateAndTime is the time of the request in UTC unless the source carries a future ship date; a pickup time is not booked.",
    "/carrier/serviceCode is passed through unchanged unless the serviceCode parameter is sent, so another carrier's code reaches DHL as is.",
    "A dutiable shipment needs customs line items with countryOfOrigin and weight, an incoterm, and some identifier for the invoice number.",
    "The content description is the customs contents description, else the first customs line description, else the first package description, else \"General goods\". DHL caps it at 70 printable ASCII characters and the plan does not shorten it.",
    "Only clientReferenceId is sent as a reference."
  ]
}
