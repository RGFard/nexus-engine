{
  "planId": "canonical-to-dhl/shipment-create-request",
  "planVersion": "1.0.0",
  "description": "Fixed outbound plan: canonical shipment-create-request to the DHL shipment request. Written by hand as the reverse of the inbound DHL mappings, so it runs without the heuristic or AI.",
  "targetName": "DHL",
  "sourceSchemaId": "canonical://shipment/shipment-create-request",
  "targetSchemaId": "target://dhl/shipment-create-request",
  "mappings": [
    {
      "sourceField": "/metadata/createdAt",
      "targetField": "/ShipmentCreationDate",
      "confidence": 1,
      "transformation": "date:iso8601",
      "reasoning": "Shipment creation timestamp."
    },
    {
      "sourceField": "/customs/declaredValue/currency",
      "targetField": "/DeclaredValueCurrecyCode",
      "confidence": 1,
      "transformation": "normalize:currency|cast:string",
      "reasoning": "Currency of the declared value. DHL spells the field Currecy."
    },
    {
      "sourceField": "/carrier/accountNumber",
      "targetField": "/ShipmentInfo/Account",
      "confidence": 1,
      "transformation": "direct|cast:string",
      "reasoning": "Carrier billing account."
    },
    {
      "sourceField": "/carrier/serviceCode",
      "targetField": "/ShipmentInfo/ServiceType",
      "confidence": 1,
      "transformation": "direct|cast:string",
      "reasoning": "Carrier product code, passed through as is. Only correct when the code is already a DHL code."
    },
    {
      "sourceField": "/origin/name",
      "targetField": "/Shipper/Contact/PersonName",
      "confidence": 1,
      "transformation": "direct|cast:string",
      "reasoning": "Sender contact person."
    },
    {
      "sourceField": "/origin/company",
      "targetField": "/Shipper/Contact/CompanyName",
      "confidence": 1,
      "transformation": "direct|cast:string",
      "reasoning": "Sender company."
    },
    {
      "sourceField": "/origin/phone",
      "targetField": "/Shipper/Contact/PhoneNumber",
      "confidence": 1,
      "transformation": "direct|cast:string",
      "reasoning": "Sender phone."
    },
    {
      "sourceField": "/origin/email",
      "targetField": "/Shipper/Contact/EmailAddress",
      "confidence": 1,
      "transformation": "direct|cast:string",
      "reasoning": "Sender email."
    },
    {
      "sourceField": "/origin/line1",
      "targetField": "/Shipper/Address/StreetLines",
      "confidence": 1,
      "transformation": "direct|cast:string",
      "reasoning": "Sender street, first line only."
    },
    {
      "sourceField": "/origin/city",
      "targetField": "/Shipper/Address/City",
      "confidence": 1,
      "transformation": "direct|cast:string",
      "reasoning": "Sender city."
    },
    {
      "sourceField": "/origin/postalCode",
      "targetField": "/Shipper/Address/PostalCode",
      "confidence": 1,
      "transformation": "direct|cast:string",
      "reasoning": "Sender postal code."
    },
    {
      "sourceField": "/origin/countryCode",
      "targetField": "/Shipper/Address/CountryCode",
      "confidence": 1,
      "transformation": "direct|normalize:countryCode|cast:string",
      "reasoning": "Sender country code."
    },
    {
      "sourceField": "/destination/name",
      "targetField": "/Recipient/Contact/PersonName",
      "confidence": 1,
      "transformation": "direct|cast:string",
      "reasoning": "Receiver contact person."
    },
    {
      "sourceField": "/destination/company",
      "targetField": "/Recipient/Contact/CompanyName",
      "confidence": 1,
      "transformation": "direct|cast:string",
      "reasoning": "Receiver company."
    },
    {
      "sourceField": "/destination/phone",
      "targetField": "/Recipient/Contact/PhoneNumber",
      "confidence": 1,
      "transformation": "direct|cast:string",
      "reasoning": "Receiver phone."
    },
    {
      "sourceField": "/destination/email",
      "targetField": "/Recipient/Contact/EmailAddress",
      "confidence": 1,
      "transformation": "direct|cast:string",
      "reasoning": "Receiver email."
    },
    {
      "sourceField": "/destination/line1",
      "targetField": "/Recipient/Address/StreetLines",
      "confidence": 1,
      "transformation": "direct|cast:string",
      "reasoning": "Receiver street, first line only."
    },
    {
      "sourceField": "/destination/city",
      "targetField": "/Recipient/Address/City",
      "confidence": 1,
      "transformation": "direct|cast:string",
      "reasoning": "Receiver city."
    },
    {
      "sourceField": "/destination/postalCode",
      "targetField": "/Recipient/Address/PostalCode",
      "confidence": 1,
      "transformation": "direct|cast:string",
      "reasoning": "Receiver postal code."
    },
    {
      "sourceField": "/destination/countryCode",
      "targetField": "/Recipient/Address/CountryCode",
      "confidence": 1,
      "transformation": "direct|normalize:countryCode|cast:string",
      "reasoning": "Receiver country code."
    },
    {
      "sourceField": "/packages[]/weight/value",
      "targetField": "/Packages/RequestedPackages[]/Weight/Value",
      "confidence": 1,
      "transformation": "array:map|cast:number",
      "reasoning": "Package weight."
    },
    {
      "sourceField": "/packages[]/weight/unit",
      "targetField": "/Packages/RequestedPackages[]/Weight/Unit",
      "confidence": 1,
      "transformation": "array:map|cast:string|normalize:uppercase",
      "reasoning": "Package weight unit. Already converted to a unit DHL takes (see units), then sent in capitals."
    },
    {
      "sourceField": "/packages[]/dimensions/length",
      "targetField": "/Packages/RequestedPackages[]/Dimensions/Length",
      "confidence": 1,
      "transformation": "array:map|cast:number",
      "reasoning": "Package length."
    },
    {
      "sourceField": "/packages[]/dimensions/width",
      "targetField": "/Packages/RequestedPackages[]/Dimensions/Width",
      "confidence": 1,
      "transformation": "array:map|cast:number",
      "reasoning": "Package width."
    },
    {
      "sourceField": "/packages[]/dimensions/height",
      "targetField": "/Packages/RequestedPackages[]/Dimensions/Height",
      "confidence": 1,
      "transformation": "array:map|cast:number",
      "reasoning": "Package height."
    },
    {
      "sourceField": "/packages[]/dimensions/unit",
      "targetField": "/Packages/RequestedPackages[]/Dimensions/Unit",
      "confidence": 1,
      "transformation": "array:map|cast:string|normalize:uppercase",
      "reasoning": "Package dimension unit. Already converted to a unit DHL takes (see units), then sent in capitals."
    },
    {
      "sourceField": "/identifiers/clientReferenceId",
      "targetField": "/Packages/RequestedPackages[]/CustomerReferences",
      "confidence": 1,
      "transformation": "direct|cast:string",
      "reasoning": "Client reference, carried on the package."
    },
    {
      "sourceField": "/customs/declaredValue/amount",
      "targetField": "/InternationalDetail/ExportDeclaration/InvoiceTotal",
      "confidence": 1,
      "transformation": "direct|cast:number",
      "reasoning": "Total declared value of the shipment."
    },
    {
      "sourceField": "/customs/declaredValue/amount",
      "targetField": "/InternationalDetail/Commodities/CustomsValue",
      "confidence": 1,
      "transformation": "direct|cast:number",
      "reasoning": "Total declared value. DHL has one Commodities block, so it carries the shipment total."
    },
    {
      "sourceField": "/customs/lineItems[]/description",
      "targetField": "/InternationalDetail/Commodities/Description",
      "confidence": 1,
      "transformation": "array:first|cast:string",
      "reasoning": "Goods description, first line item."
    },
    {
      "sourceField": "/customs/lineItems[]/quantity",
      "targetField": "/InternationalDetail/Commodities/Quantity",
      "confidence": 1,
      "transformation": "array:first|cast:number",
      "reasoning": "Quantity, first line item."
    },
    {
      "sourceField": "/customs/lineItems[]/unitValue/amount",
      "targetField": "/InternationalDetail/Commodities/UnitPrice",
      "confidence": 1,
      "transformation": "array:first|cast:number",
      "reasoning": "Unit price, first line item."
    },
    {
      "sourceField": "/customs/lineItems[]/hsCode",
      "targetField": "/InternationalDetail/Commodities/HarmonizedCode",
      "confidence": 1,
      "transformation": "array:first|cast:string",
      "reasoning": "HS tariff code, first line item."
    },
    {
      "sourceField": "/customs/lineItems[]/countryOfOrigin",
      "targetField": "/InternationalDetail/Commodities/CountryOfManufacture",
      "confidence": 1,
      "transformation": "array:first|normalize:countryCode|cast:string",
      "reasoning": "Country of manufacture, first line item."
    }
  ],
  "unmappedSourceFields": [],
  "unmappedTargetFields": [
    "/InternationalDetail/Content"
  ],
  "parameters": {
    "serviceCode": {
      "targetField": "/ShipmentInfo/ServiceType",
      "description": "DHL product code to ship with, e.g. P for Express Worldwide. Send it when the shipment did not come from DHL: other sources carry no service code, or carry another carrier's code. When given, it replaces /carrier/serviceCode.",
      "header": "X-Service-Code"
    },
    "accountNumber": {
      "targetField": "/ShipmentInfo/Account",
      "description": "DHL account to bill. Send it when the source carries no DHL account number. When given, it replaces /carrier/accountNumber.",
      "header": "X-Account-Number"
    }
  },
  "units": {
    "weight": {
      "accepted": [
        "kg",
        "lb"
      ],
      "convert": {
        "oz": "lb",
        "g": "kg"
      }
    },
    "dimension": {
      "accepted": [
        "cm",
        "in"
      ],
      "convert": {
        "m": "cm"
      }
    }
  },
  "knownGaps": [
    "/InternationalDetail/Content is not mapped. It needs the reverse of normalize:contentsType (merchandise to NON_DOCUMENTS).",
    "/carrier/serviceCode is passed through unchanged unless the request supplies the serviceCode parameter. Without it, a UPS or FedEx code goes to DHL as is, and a source with no service code fails the DHL schema.",
    "DHL has a single Commodities block, so only the first customs line item is sent.",
    "Address line2, line3 and stateOrProvince are not sent. The DHL schema has no fields for them yet."
  ]
}
