{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical://shipment/shipment-error",
  "title": "ShipmentError",
  "description": "Canonical error envelope for shipment operations",
  "x-canonical-version": "1.0.0",
  "x-canonical-domain": "shipment",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message"],
  "properties": {
    "code": { "type": "string", "minLength": 1 },
    "message": { "type": "string", "minLength": 1 },
    "details": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "issue"],
        "additionalProperties": false,
        "properties": {
          "field": { "type": "string" },
          "issue": { "type": "string" }
        }
      }
    },
    "metadata": { "$ref": "canonical://shared/metadata" },
    "extensions": {
      "type": "object",
      "description": "Carrier- or integration-specific extensible fields",
      "additionalProperties": true
    }
  }
}
